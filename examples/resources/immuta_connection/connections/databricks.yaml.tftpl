# Databricks connection captured in example_queries.md, without its credential,
# which is set with the credential attribute. technology (Databricks) and
# connectionKey (fd) are set with attributes too.
clientConfiguration:
  host: "fd"
  path: "ds"
  port: 2
  immutaSystemCatalog: "3232"
policyConfiguration:
  excludeGroupPattern: "dasd"
auditConfiguration:
  enabled: true
  workspaceIds:
    - "23232"
dataObjectSync:
  enabled: true
  startTime: 0
  schedule: "EVERY_24_HOURS"
syncOnCreate: true
dataObjectDefaults:
  syncPolicy: false
  # Immuta user profile ID, filled in by templatefile() from data.immuta_user.
  owners:
    - type: "USER"
      id: ${owner_id}
